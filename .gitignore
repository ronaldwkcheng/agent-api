# Package Files #
*.jar
# The Gradle wrapper jar must be committed — ./gradlew cannot run without it.
# This negation has to sit after *.jar: git applies the last matching pattern.
!gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

